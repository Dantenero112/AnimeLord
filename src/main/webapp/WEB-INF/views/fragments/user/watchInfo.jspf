<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="watch-info-section">

    <div class="watch-info-card">

        <%-- Cover Image --%>

        <div class="watch-cover-wrapper">

            <a href="${pageContext.request.contextPath}/animeDetails?id=${anime.animeId}">

                <img
                    src="${pageContext.request.contextPath}${anime.coverImage}"
                    alt="${anime.title}"
                    class="watch-cover">

            </a>

        </div>

        <%-- Anime / Episode Info --%>

        <div class="watch-details">

            <a href="${pageContext.request.contextPath}/animeDetails?id=${anime.animeId}"
               class="watch-anime-title">

                ${anime.title}

            </a>

            <div class="watch-episode-title">

                Episode ${episode.episodeNumber}

                <c:if test="${not empty episode.episodeTitle}">

                    -

                    ${episode.episodeTitle}

                </c:if>

            </div>

        </div>

    </div>

</section>