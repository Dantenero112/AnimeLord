<%@ page pageEncoding="UTF-8" %>

<div id="overlay"
     class="overlay"></div>

<div id="userDrawer"
     class="user-drawer">

    <div class="drawer-header">

        <div class="brand">

            Anime<span>Lord</span>

        </div>

        <button
            id="closeDrawerBtn"
            class="close-btn">

            <i class="bi bi-x-lg"></i>

        </button>

    </div>

    <nav class="drawer-nav">

        <!-- HOME -->

        <a href="${pageContext.request.contextPath}/"
           class="drawer-link">

            <i class="bi bi-house"></i>

            Home

        </a>

        <!-- BROWSE ANIME -->

        <a href="${pageContext.request.contextPath}/anime"
           class="drawer-link">

            <i class="bi bi-collection-play"></i>

            Browse Anime

        </a>

        <!-- GENRES -->

        <a href="${pageContext.request.contextPath}/genres"
           class="drawer-link">

            <i class="bi bi-tags"></i>

            Genres

        </a>

        <!-- TRENDING -->

        <a href="${pageContext.request.contextPath}/trending"
           class="drawer-link">

            <i class="bi bi-fire"></i>

            Trending

        </a>

        <!-- ONGOING -->

        <a href="${pageContext.request.contextPath}/ongoing"
           class="drawer-link">

            <i class="bi bi-broadcast"></i>

            Ongoing Anime

        </a>

        <!-- RECENTLY ADDED -->

        <a href="${pageContext.request.contextPath}/recent"
           class="drawer-link">

            <i class="bi bi-clock-history"></i>

            Recently Added

        </a>

        <!-- NEW RELEASES -->

        <a href="${pageContext.request.contextPath}/new-releases"
           class="drawer-link">

            <i class="bi bi-stars"></i>

            New Releases

        </a>

        <!-- COMPLETED -->

        <a href="${pageContext.request.contextPath}/completed"
           class="drawer-link">

            <i class="bi bi-check-circle"></i>

            Completed Anime

        </a>

        <!-- UPCOMING -->

        <a href="${pageContext.request.contextPath}/upcoming"
           class="drawer-link">

            <i class="bi bi-rocket-takeoff"></i>

            Upcoming Anime

        </a>

        <!-- USER FEATURES -->

        <hr class="drawer-divider">

        <!-- WATCHLIST -->

        <a href="${pageContext.request.contextPath}/watchlist"
           class="drawer-link">

            <i class="bi bi-bookmark-heart"></i>

            My Watchlist

        </a>

        <!-- WATCH HISTORY -->

        <a href="${pageContext.request.contextPath}/history"
           class="drawer-link">

            <i class="bi bi-clock"></i>

            Watch History

        </a>

    </nav>

</div>