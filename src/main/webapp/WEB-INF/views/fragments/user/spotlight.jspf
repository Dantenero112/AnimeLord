                Ep 12
            </div>

            <div class="card-body">

                <h5>Featured Anime</h5>

            </div>

        </div>

        <div class="anime-card">

            <img
                src="https://via.placeholder.com/400x250"
                alt="Trending Anime">

            <div class="ep-badge">
                Ep 24
            </div>

            <div class="card-body">

                <h5>Trending Anime</h5>

            </div>

        </div>

    </div>

</section>