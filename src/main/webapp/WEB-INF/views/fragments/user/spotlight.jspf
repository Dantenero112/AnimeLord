<%@ page pageEncoding="UTF-8" %>
<section class="spotlight">

    <h2 class="section-title">

        🌌 Spotlight Picks

    </h2>

    <div class="scroll-container">

        <div class="anime-card">

            <img
                src="https://via.placeholder.com/400x250"
                alt="Featured Anime">

