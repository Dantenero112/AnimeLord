<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="recently-added-section">

    <div class="section-header">

        <a href="${pageContext.request.contextPath}/recent"
           class="section-link">

            📺 Recently Added Episodes →

        </a>

    </div>

    <div class="episode-grid">

        <c:forEach items="${recentEpisodes}"
                   var="episode">

            <div class="episode-card">

                <div class="episode-thumbnail-wrapper">

                    <img
                        src="${episode.thumbnailPath}"
                        alt="${episode.animeTitle}"
                        class="episode-thumbnail">

                    <div class="episode-badge">

                        EP ${episode.episodeNumber}

                    </div>

                </div>

                <div class="episode-card-body">

                    <h5 class="episode-anime-title">

                        ${episode.animeTitle}

                    </h5>

                    <p class="episode-title">

                        ${episode.episodeTitle}

                    </p>

                    <div class="episode-meta">

                        <span>

                            ${episode.uploadDate}

                        </span>

                    </div>

                    <a href="${pageContext.request.contextPath}/watch?episodeId=${episode.episodeId}"
                       class="episode-btn">

                        Watch Now

                    </a>

                </div>

            </div>

        </c:forEach>

    </div>

</section>