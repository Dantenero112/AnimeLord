<%@ page pageEncoding="UTF-8" %>

<div class="anime-card">

    <img
        src="${pageContext.request.contextPath}${coverImage}"
        alt="${animeTitle}">

    <div class="ep-badge">

        Ep ${episodeNumber}

    </div>

    <div class="card-body">

        <small>

            ${animeTitle}

        </small>

    </div>

</div>