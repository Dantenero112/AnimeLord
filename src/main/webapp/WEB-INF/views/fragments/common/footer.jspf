<%@ page pageEncoding="UTF-8" %>
<footer class="footer">

    <div class="container footer-container">

        <div class="row">

            <!-- Brand -->

            <div class="col-lg-5 col-md-12 mb-4 footer-brand-column">

                <div class="footer-brand">
                    Anime<span>Lord</span>
                </div>

                <p class="footer-text">
                    Stream your favorite anime episodes with fast HLS playback,
                    organized collections, and a smooth viewing experience.
                </p>

            </div>

            <!-- Navigation -->

            <div class="col-lg-2 col-md-4 col-sm-4 mb-4">

                <h4>Navigation</h4>

                <ul class="footer-links">

                    <li>
                        <a href="${pageContext.request.contextPath}/">
                            Home
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Anime
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Search
                        </a>
                    </li>

                </ul>

            </div>

            <!-- Support -->

            <div class="col-lg-2 col-md-4 col-sm-4 mb-4">

                <h4>Support</h4>

                <ul class="footer-links">

                    <li>
                        <a href="#">
                            Feedback
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Report Episode
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Contact
                        </a>
                    </li>

                </ul>

            </div>

            <!-- Platform -->

            <div class="col-lg-3 col-md-4 col-sm-4 mb-4">

                <h4>Platform</h4>

                <ul class="footer-stats">

                    <li>
                        Anime :
                        <strong>${animeCount != null ? animeCount : 0}</strong>
                    </li>

                    <li>
                        Episodes :
                        <strong>${episodeCount != null ? episodeCount : 0}</strong>
                    </li>

                    <li>
                        Status :
                        <span class="text-success">
                            Online
                        </span>
                    </li>

                </ul>

            </div>

        </div>

        <hr class="footer-divider">

        <div class="footer-bottom">

            <div class="footer-bottom-left">
                © AnimeLord
            </div>

            <div class="footer-bottom-right">
                Powered by JSP • Servlets • HLS
            </div>

        </div>

    </div>

</footer>