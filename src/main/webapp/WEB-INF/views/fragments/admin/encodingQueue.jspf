<%@ page pageEncoding="UTF-8" %>
<div
        id="encoding"
        class="glass-card">

    <h5 class="mb-3">

        ⚡ Encoding Queue

    </h5>

    <div class="table-responsive">

        <table
                class="table table-dark table-hover">

            <thead>

            <tr>

                <th>Anime</th>
                <th>Episode</th>
                <th>Status</th>

            </tr>

            </thead>

            <tbody>

            <tr>

                <td>Example Anime</td>
                <td>Ep 5</td>
                <td>Processing</td>

            </tr>

            </tbody>

        </table>

    </div>

</div>