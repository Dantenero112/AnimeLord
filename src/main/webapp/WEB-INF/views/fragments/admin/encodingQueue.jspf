<div id="encoding"
     class="glass-card">

    <h5 class="mb-3">

        ? Encoding Queue

    </h5>

    <div class="table-responsive">

        <table
                class="table table-dark table-hover">

            <thead>

            <tr>

                <th>Anime</th>
                <th>Episode</th>
                <th>Status</th>

            </tr>

            </thead>

            <tbody>

                ${queueRows}

            </tbody>

        </table>

    </div>

</div>