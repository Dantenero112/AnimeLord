<div id="upload"
     class="glass-card">

    <h5 class="mb-3">
        ? Upload Episode
    </h5>

    <form
            action="${pageContext.request.contextPath}/uploadEpisode"
            method="post"
            enctype="multipart/form-data">

        <div class="row g-3">

            <div class="col-md-4">

                <input
                        name="animeTitle"
                        class="form-control"
                        placeholder="Anime Title">

            </div>

            <div class="col-md-2">

                <input
                        name="episodeNumber"
                        class="form-control"
                        type="number">

            </div>

            <div class="col-md-6">

                <input
                        name="video"
                        class="form-control"
                        type="file">

            </div>

        </div>

        <button
                class="btn btn-neon mt-3">

            Upload

        </button>

    </form>

</div>