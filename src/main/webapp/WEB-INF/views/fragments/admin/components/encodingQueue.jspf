<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="admin-section">

    <div class="dashboard-header">

        <div>

            <h2>

                ⚙ Encoding Queue

            </h2>

            <p>

                Monitor uploaded episodes waiting for encoding.

            </p>

        </div>

    </div>

  

    <div class="glass-card">

        <div
            style="
                display:flex;
                gap:10px;
                flex-wrap:wrap;
            ">

            <a
                href="${pageContext.request.contextPath}/encodingQueue"
                class="btn-neon">

                📋 All

            </a>

            <a
                href="${pageContext.request.contextPath}/encodingQueue?status=QUEUED"
                class="btn-neon">

                ⏳ QUEUED

            </a>

            <a
                href="${pageContext.request.contextPath}/encodingQueue?status=PROCESSING"
                class="btn-neon">

                ⚙ PROCESSING

            </a>

            <a
                href="${pageContext.request.contextPath}/encodingQueue?status=COMPLETED"
                class="btn-neon">

                ✅ COMPLETED

            </a>

            <a
                href="${pageContext.request.contextPath}/encodingQueue?status=FAILED"
                class="btn-neon">

                ❌ FAILED

            </a>

        </div>

    </div>

 

    <div class="glass-card">

        <div class="table-wrapper">

            <table
                class="table table-dark table-hover align-middle">

                <thead>

                    <tr>

                        <th>Queue ID</th>

                        <th>Episode ID</th>

                        <th>Status</th>

                        <th>1080p</th>

                        <th>720p</th>

                        <th>480p</th>

                        <th>Created</th>

                        <th>Updated</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <c:choose>

                        <c:when test="${not empty queueList}">

                            <c:forEach
                                var="queue"
                                items="${queueList}">

                                <tr>

                                    <td>

                                        ${queue.queueId}

                                    </td>

                                    <td>

                                        ${queue.episodeId}

                                    </td>

                                    <td>

                                        <c:choose>

                                            <c:when test="${queue.status eq 'QUEUED'}">

                                                <span class="status-queued">

                                                    QUEUED

                                                </span>

                                            </c:when>

                                            <c:when test="${queue.status eq 'PROCESSING'}">

                                                <span class="status-processing">

                                                    PROCESSING

                                                </span>

                                            </c:when>

                                            <c:when test="${queue.status eq 'COMPLETED'}">

                                                <span class="status-complete">

                                                    COMPLETED

                                                </span>

                                            </c:when>

                                            <c:otherwise>

                                                <span class="status-failed">

                                                    FAILED

                                                </span>

                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                 

                                    <td>

                                        <c:choose>

                                            <c:when test="${queue.encode1080p}">

                                                ✅

                                            </c:when>

                                            <c:otherwise>

                                                ❌

                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                   

                                    <td>

                                        <c:choose>

                                            <c:when test="${queue.encode720p}">

                                                ✅

                                            </c:when>

                                            <c:otherwise>

                                                ❌

                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                    

                                    <td>

                                        <c:choose>

                                            <c:when test="${queue.encode480p}">

                                                ✅

                                            </c:when>

                                            <c:otherwise>

                                                ❌

                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                    <td>

                                        ${queue.createdAt}

                                    </td>

                                    <td>

                                        ${queue.updatedAt}

                                    </td>

                                    <td>

                                        <c:choose>

                                         

                                            <c:when test="${queue.status eq 'QUEUED'}">

                                                <a
                                                    href="${pageContext.request.contextPath}/startEncoding?episodeId=${queue.episodeId}"
                                                    class="btn btn-sm btn-success"
                                                    onclick="return confirm('Start encoding this episode?');">

                                                    ▶ Start Encoding

                                                </a>

                                            </c:when>

                                           

                                            <c:when test="${queue.status eq 'PROCESSING'}">

                                                <span
                                                    class="btn btn-sm btn-warning disabled">

                                                    ⚙ Processing...

                                                </span>

                                            </c:when>

                                      

                                            <c:when test="${queue.status eq 'COMPLETED'}">

                                                <span
                                                    class="btn btn-sm btn-success disabled">

                                                    ✅ Encoded

                                                </span>

                                            </c:when>

                                          

                                            <c:otherwise>

                                                <a
                                                    href="${pageContext.request.contextPath}/startEncoding?episodeId=${queue.episodeId}"
                                                    class="btn btn-sm btn-danger">

                                                    🔄 Retry

                                                </a>

                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                </tr>

                            </c:forEach>

                        </c:when>

                        <c:otherwise>

                            <tr>

                                <td
                                    colspan="9"
                                    class="text-center py-4">

                                    No queue items found.

                                </td>

                            </tr>

                        </c:otherwise>

                    </c:choose>

                </tbody>

            </table>

        </div>

    </div>

</section>