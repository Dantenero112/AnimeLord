<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="admin-section">

    <div class="admin-section-header">

        <h2>
            📚 Manage Anime
        </h2>

        <p>
            View, edit and manage all anime available on AnimeLord.
        </p>

    </div>

    <!-- SEARCH & ACTIONS -->

    <div class="glass-card">

        <div class="admin-action-bar">

            <form method="get" action="${pageContext.request.contextPath}/admin" class="admin-search-form">

                <input
                    type="hidden"
                    name="view"
                    value="manageAnime">

                <input
                    type="text"
                    name="search"
                    value="${param.search}"
                    class="form-control"
                    placeholder="Search anime...">

                <button
                    type="submit"
                    class="btn-neon">

                    🔍 Search

                </button>

            </form>

            <a href="${pageContext.request.contextPath}/admin?view=addAnime"
   class="btn-neon admin-action-btn">

                ➕ Add Anime

            </a>

        </div>

    </div>

    <!-- ANIME TABLE -->

    <div class="glass-card">

        <div class="table-wrapper">

            <table class="table table-dark table-hover align-middle">

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Cover</th>

                        <th>Title</th>

                        <th>Year</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <c:choose>

                        <c:when test="${not empty animeList}">

                            <c:forEach items="${animeList}"
                                       var="anime">

                                <tr>

                                    <td>
                                        ${anime.animeId}
                                    </td>

                                    <td>

                                        <img
                                            src="${pageContext.request.contextPath}${anime.coverImage}"
                                            alt="${anime.title}"
                                            style="
                                                width:60px;
                                                height:80px;
                                                object-fit:cover;
                                                border-radius:8px;
                                            ">

                                    </td>

                                    <td>
                                        ${anime.title}
                                    </td>

                                    <td>
                                        ${anime.releaseYear}
                                    </td>

                                    <td>

                                        <c:choose>

                                            <c:when test="${anime.status eq 'ONGOING'}">

                                                <span class="status-processing">
                                                    ONGOING
                                                </span>

                                            </c:when>

                                            <c:when test="${anime.status eq 'COMPLETED'}">

                                                <span class="status-complete">
                                                    COMPLETED
                                                </span>

                                            </c:when>

                                            <c:otherwise>

                                                <span class="status-queued">
                                                    UPCOMING
                                                </span>

                                            </c:otherwise>

                                        </c:choose>

                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <a
                                                href="${pageContext.request.contextPath}/admin?view=editAnime&id=${anime.animeId}"
                                                class="btn btn-sm btn-warning">

                                                ✏ Edit

                                            </a>

                                            <a
                                                href="${pageContext.request.contextPath}/deleteAnime?id=${anime.animeId}"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Delete this anime?');">

                                                🗑 Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            </c:forEach>

                        </c:when>

                        <c:otherwise>

                            <tr>

                                <td colspan="6"
                                    class="text-center py-4">

                                    No anime found.

                                </td>

                            </tr>

                        </c:otherwise>

                    </c:choose>

                </tbody>

            </table>

        </div>

    </div>

</section>