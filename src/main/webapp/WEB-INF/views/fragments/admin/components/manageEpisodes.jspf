<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="dashboard-header">

    <div>

        <h2>

            🎞 Manage Episodes

        </h2>

        <p>

            View, edit and manage uploaded episodes.

        </p>

    </div>

    <a
        href="${pageContext.request.contextPath}/admin?view=uploadEpisode"
        class="btn-neon">

        ➕ Upload Episode

    </a>

</div>

<!-- SUCCESS MESSAGE -->

<c:if test="${not empty sessionScope.successMessage}">

    <div
        id="successAlert"
        class="alert alert-success mb-3">

        ${sessionScope.successMessage}

    </div>

    <c:remove
            var="successMessage"
            scope="session"/>

</c:if>

<!-- ERROR MESSAGE -->

<c:if test="${not empty sessionScope.errorMessage}">

    <div
        id="errorAlert"
        class="alert alert-danger mb-3">

        ${sessionScope.errorMessage}

    </div>

    <c:remove
            var="errorMessage"
            scope="session"/>

</c:if>

<!-- SEARCH + FILTER -->

<div class="glass-card">

    <form
        method="get"
        action="${pageContext.request.contextPath}/admin">

        <input
            type="hidden"
            name="view"
            value="manageEpisodes">

        <div
            style="
                display:flex;
                gap:10px;
                flex-wrap:wrap;
            ">

            <input
                type="text"
                name="search"
                value="${param.search}"
                class="form-control"
                placeholder="Search episode title...">

            <select
                name="animeId"
                class="form-select"
                style="max-width:250px;">

                <option value="">

                    All Anime

                </option>

                <c:forEach
                    var="anime"
                    items="${animeList}">

                    <option
                        value="${anime.animeId}"
                        ${param.animeId == anime.animeId.toString() ? 'selected' : ''}>

                        ${anime.title}

                    </option>

                </c:forEach>

            </select>

            <button
                type="submit"
                class="btn-neon">

                🔍 Apply

            </button>

        </div>

    </form>

</div>

<!-- EPISODE TABLE -->

<div class="glass-card">

    <div class="table-wrapper">

        <table
            class="table table-dark table-hover">

            <thead>

                <tr>

                    <th>ID</th>

                    <th>Anime ID</th>

                    <th>Episode</th>

                    <th>Title</th>

                    <th>Duration</th>

                    <th>Upload Date</th>

                    <th>Actions</th>

                </tr>

            </thead>

            <tbody>

                <c:choose>

                    <c:when test="${not empty episodeList}">

                        <c:forEach
                            var="episode"
                            items="${episodeList}">

                            <tr>

                                <td>

                                    ${episode.episodeId}

                                </td>

                                <td>

                                    ${episode.animeId}

                                </td>

                                <td>

                                    ${episode.episodeNumber}

                                </td>

                                <td>

                                    ${episode.episodeTitle}

                                </td>

                                <td>

                                    ${episode.durationSeconds}
                                    sec

                                </td>

                                <td>

                                    ${episode.uploadDate}

                                </td>

                                <td>

                                    <div
                                        class="d-flex gap-2 flex-wrap">

                                        <a
                                            href="${pageContext.request.contextPath}/admin?view=editEpisode&id=${episode.episodeId}"
                                            class="btn btn-sm btn-warning">

                                            ✏ Edit

                                        </a>

                                        <a
                                            href="${pageContext.request.contextPath}/deleteEpisode?id=${episode.episodeId}"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Delete this episode?');">

                                            🗑 Delete

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        </c:forEach>

                    </c:when>

                    <c:otherwise>

                        <tr>

                            <td
                                colspan="7"
                                class="text-center">

                                No episodes found.

                            </td>

                        </tr>

                    </c:otherwise>

                </c:choose>

            </tbody>

        </table>

    </div>

</div>