<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="admin-section">

    <!-- WELCOME -->

    <div class="glass-card">

        <h2>

            👋 Welcome,
            ${sessionScope.user.username}

        </h2>

        <p>

            Manage anime, episodes, genres, uploads,
            encoding jobs and platform content.

        </p>

    </div>

    <!-- STATS -->

    <div class="stats-grid">

        <div class="stat-card">

            <h3>

                ${totalAnime}

            </h3>

            <p>

                Total Anime

            </p>

        </div>

        <div class="stat-card">

            <h3>

                ${totalEpisodes}

            </h3>

            <p>

                Total Episodes

            </p>

        </div>

        <div class="stat-card">

            <h3>

                0

            </h3>

            <p>

                Encoding Jobs

            </p>

        </div>

        <div class="stat-card">

            <h3>

                0

            </h3>

            <p>

                Pending Reports

            </p>

        </div>

    </div>

    <!-- QUICK ACTIONS -->

    <div class="glass-card">

        <h5>

            ⚡ Quick Actions

        </h5>

        <div class="form-actions">

            <a
                href="${pageContext.request.contextPath}/admin?view=addAnime"
                class="btn-admin-primary">

                ➕ Add Anime

            </a>

            <a
                href="${pageContext.request.contextPath}/admin?view=uploadEpisode"
                class="btn-admin-primary">

                🎥 Upload Episode

            </a>

            <a
                href="${pageContext.request.contextPath}/admin?view=manageAnime"
                class="btn-admin-secondary">

                📚 Manage Anime

            </a>

            <a
                href="${pageContext.request.contextPath}/admin?view=manageEpisodes"
                class="btn-admin-secondary">

                📺 Manage Episodes

            </a>

            <a
                href="${pageContext.request.contextPath}/admin?view=encodingQueue"
                class="btn-admin-secondary">

                ⚙ Encoding Queue

            </a>

        </div>

    </div>

    <!-- RECENT ANIME -->

    <div class="glass-card">

        <div
            style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                margin-bottom:15px;
            ">

            <h5>

                🎬 Recently Added Anime

            </h5>

            <a
                href="${pageContext.request.contextPath}/admin?view=manageAnime">

                View All →

            </a>

        </div>

        <div class="table-wrapper">

            <table
                class="table table-dark table-hover">

                <thead>

                    <tr>

                        <th>

                            ID

                        </th>

                        <th>

                            Title

                        </th>

                        <th>

                            Year

                        </th>

                        <th>

                            Status

                        </th>

                        <th>

                            Views

                        </th>

                    </tr>

                </thead>

                <tbody>

                    <c:forEach
                        items="${recentAnime}"
                        var="anime">

                        <tr>

                            <td>

                                ${anime.animeId}

                            </td>

                            <td>

                                ${anime.title}

                            </td>

                            <td>

                                ${anime.releaseYear}

                            </td>

                            <td>

                                ${anime.status}

                            </td>

                            <td>

                                ${anime.totalViews}

                            </td>

                        </tr>

                    </c:forEach>

                </tbody>

            </table>

        </div>

    </div>

    <!-- RECENT EPISODES -->

    <div class="glass-card">

        <div
            style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                margin-bottom:15px;
            ">

            <h5>

                📺 Recently Added Episodes

            </h5>

            <a
                href="${pageContext.request.contextPath}/admin?view=manageEpisodes">

                View All →

            </a>

        </div>

        <div class="table-wrapper">

            <table
                class="table table-dark table-hover">

                <thead>

                    <tr>

                        <th>

                            Episode ID

                        </th>

                        <th>

                            Anime ID

                        </th>

                        <th>

                            Episode

                        </th>

                        <th>

                            Title

                        </th>

                    </tr>

                </thead>

                <tbody>

                    <c:forEach
                        items="${recentEpisodes}"
                        var="episode">

                        <tr>

                            <td>

                                ${episode.episodeId}

                            </td>

                            <td>

                                ${episode.animeId}

                            </td>

                            <td>

                                ${episode.episodeNumber}

                            </td>

                            <td>

                                ${episode.episodeTitle}

                            </td>

                        </tr>

                    </c:forEach>

                </tbody>

            </table>

        </div>

    </div>

</section>