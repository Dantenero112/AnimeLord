<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<div class="admin-section-header">

    <h2>

        📺 Upload Episode

    </h2>

    <p>

        Upload a new episode for an existing anime.

    </p>

</div>

<!-- SUCCESS MESSAGE -->

<c:if test="${not empty sessionScope.successMessage}">

    <div class="alert alert-success">

        ${sessionScope.successMessage}

    </div>

    <c:remove
            var="successMessage"
            scope="session"/>

</c:if>

<!-- ERROR MESSAGE -->

<c:if test="${not empty sessionScope.errorMessage}">

    <div class="alert alert-danger">

        ${sessionScope.errorMessage}

    </div>

    <c:remove
            var="errorMessage"
            scope="session"/>

</c:if>

<div class="admin-card">

    <form
        action="${pageContext.request.contextPath}/saveEpisode"
        method="post"
        enctype="multipart/form-data"
        class="admin-form">

        <!-- ANIME SEARCH -->

        <div class="form-group">

            <label for="animeSearch">

                Search Anime

            </label>

            <input
                type="text"
                id="animeSearch"
                class="form-control"
                placeholder="Type anime title...">

        </div>

        <!-- ANIME -->

        <div class="form-group">

            <label for="animeId">

                Anime

            </label>

            <select
                id="animeId"
                name="animeId"
                required>

                <option value="">

                    Select Anime

                </option>

                <c:forEach
                    items="${animeList}"
                    var="anime">

                    <option
                        value="${anime.animeId}">

                        ${anime.title}

                    </option>

                </c:forEach>

            </select>

        </div>

        <!-- EPISODE NUMBER -->

        <div class="form-group">

            <label for="episodeNumber">

                Episode Number

            </label>

            <input
                type="number"
                id="episodeNumber"
                name="episodeNumber"
                min="1"
                required>

        </div>

        <!-- EPISODE TITLE -->

        <div class="form-group">

            <label for="episodeTitle">

                Episode Title

            </label>

            <input
                type="text"
                id="episodeTitle"
                name="episodeTitle">

        </div>

        <!-- DESCRIPTION -->

        <div class="form-group">

            <label for="description">

                Description

            </label>

            <textarea
                id="description"
                name="description"
                rows="5"></textarea>

        </div>

        <!-- ENCODING MODE -->

        <div class="form-group">

            <label>

                Encoding Mode

            </label>

            <div>

                <input
                    type="radio"
                    id="autoMode"
                    name="encodingMode"
                    value="AUTO"
                    checked>

                <label for="autoMode">

                    Auto

                </label>

            </div>

            <div>

                <input
                    type="radio"
                    id="customMode"
                    name="encodingMode"
                    value="CUSTOM">

                <label for="customMode">

                    Custom

                </label>

            </div>

        </div>

        <!-- RESOLUTIONS -->

        <div
            id="resolutionOptions"
            style="display:none;">

            <div class="form-group">

                <label>

                    Resolutions

                </label>

                <div>

                    <input
                        type="checkbox"
                        id="encode1080p"
                        name="encode1080p"
                        checked>

                    <label for="encode1080p">

                        1080p

                    </label>

                </div>

                <div>

                    <input
                        type="checkbox"
                        id="encode720p"
                        name="encode720p"
                        checked>

                    <label for="encode720p">

                        720p

                    </label>

                </div>

                <div>

                    <input
                        type="checkbox"
                        id="encode480p"
                        name="encode480p"
                        checked>

                    <label for="encode480p">

                        480p

                    </label>

                </div>

            </div>

        </div>

        <!-- VIDEO FILE -->

        <div class="form-group">

            <label for="videoFile">

                Video File

            </label>

            <input
                type="file"
                id="videoFile"
                name="videoFile"
                accept=".mp4,.mkv,.mov"
                required>

            <small>

                Supported formats:
                MP4, MKV, MOV

            </small>

        </div>

        <!-- ACTIONS -->

        <div class="form-actions">

            <button
                type="submit"
                class="btn-admin-primary">

                ⬆ Upload Episode

            </button>

            <button
                type="reset"
                class="btn-admin-secondary">

                🔄 Reset

            </button>

        </div>

    </form>

</div>