<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<section class="admin-section">

    <div class="admin-section-header">

        <h2>

            ✏ Edit Episode

        </h2>

        <p>

            Update episode information.

        </p>

    </div>

    <c:if test="${episode == null}">

        <div class="glass-card">

            <h5>

                Episode not found.

            </h5>

            <a
                href="${pageContext.request.contextPath}/admin?view=manageEpisodes"
                class="btn-neon">

                ← Back to Manage Episodes

            </a>

        </div>

    </c:if>

    <c:if test="${episode != null}">

        <div class="admin-card">

            <form
                action="${pageContext.request.contextPath}/updateEpisode"
                method="post"
                class="admin-form">

                <!-- Episode ID -->

                <input
                    type="hidden"
                    name="episodeId"
                    value="${episode.episodeId}">

                <!-- Anime ID -->

                <div class="form-group">

                    <label>

                        Anime ID

                    </label>

                    <input
                        type="text"
                        value="${episode.animeId}"
                        readonly>

                </div>

                <!-- Episode Number -->

                <div class="form-group">

                    <label for="episodeNumber">

                        Episode Number

                    </label>

                    <input
                        type="number"
                        id="episodeNumber"
                        name="episodeNumber"
                        value="${episode.episodeNumber}"
                        min="1"
                        required>

                </div>

                <!-- Episode Title -->

                <div class="form-group">

                    <label for="episodeTitle">

                        Episode Title

                    </label>

                    <input
                        type="text"
                        id="episodeTitle"
                        name="episodeTitle"
                        value="${episode.episodeTitle}">

                </div>

                <!-- Description -->

                <div class="form-group">

                    <label for="description">

                        Description

                    </label>

                    <textarea
                        id="description"
                        name="description"
                        rows="6">${episode.description}</textarea>

                </div>

                <!-- Duration -->

                <div class="form-group">

                    <label>

                        Duration (Seconds)

                    </label>

                    <input
                        type="text"
                        value="${episode.durationSeconds}"
                        readonly>

                </div>

                <!-- Uploaded Video -->

                <div class="form-group">

                    <label>

                        Uploaded Video Path

                    </label>

                    <textarea
                        rows="3"
                        readonly>${episode.uploadedVideoPath}</textarea>

                </div>

                <!-- Upload Date -->

                <div class="form-group">

                    <label>

                        Upload Date

                    </label>

                    <input
                        type="text"
                        value="${episode.uploadDate}"
                        readonly>

                </div>

                <!-- Actions -->

                <div class="form-actions">

                    <button
                        type="submit"
                        class="btn-admin-primary">

                        💾 Update Episode

                    </button>

                    <a
                        href="${pageContext.request.contextPath}/admin?view=manageEpisodes"
                        class="btn-admin-secondary">

                        ← Back

                    </a>

                </div>

            </form>

        </div>

    </c:if>

</section>